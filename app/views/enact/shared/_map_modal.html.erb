<%# Shared iframe modal for the relationship and people maps (standalone
    layout:false Cytoscape pages, so an iframe is the natural container).
    Render once per page at a top-level position: nested in a flex or transformed
    container, the modal's fixed positioning and focus trap break.
    Assets in app/assets/{stylesheets,javascripts}/enact/map_modal.*, precompiled
    via config/initializers/map_modal_assets.rb. %>
<%= stylesheet_link_tag 'enact/map_modal', media: 'all' %>
<div class="modal fade" id="enactMapModal" tabindex="-1" role="dialog"
     aria-labelledby="enactMapModalLabel" aria-modal="true">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h5 class="modal-title" id="enactMapModalLabel"></h5>
        <button type="button" class="close" data-dismiss="modal"
                aria-label="<%= t('enact.map_modal.close', default: 'Close') %>">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body p-0">
        <%# role=status announces loading to assistive tech; the spinner is
            decorative. map_modal.js toggles .is-hidden on the iframe load. %>
        <div id="enactMapLoading" class="enact-map-loading" role="status">
          <span class="enact-map-spinner" aria-hidden="true"></span>
          <span><%= t('enact.map_modal.loading', default: 'Loading the map...') %></span>
        </div>
        <iframe id="enactMapIframe" src="" title=""
                class="enact-map-iframe"></iframe>
      </div>
    </div>
  </div>
</div>
<%= javascript_include_tag 'enact/map_modal' %>
