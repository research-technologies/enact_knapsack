<%# OVERRIDE Hyrax v5.2.0 hyrax/compounds/_compound_card
    Special-cases two Enact compounds:
      - `relationships` — the "related within this project" block (outbound edges
        plus inbound edges found by a Solr reverse lookup).
      - `contributors`  — credits grouped by contributor (each person/org shown
        once with all of its roles), via Enact::WorkContributors.
    Every other card compound falls through to the upstream rendering unchanged,
    so this override stays in sync with upstream for non-special compounds.

    Locals:
      presenter - a work or collection show presenter
      field     - the compound attribute name (Symbol)
%>
<div class="card hyrax-compound-card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2 class="card-title mb-0"><%= compound_card_label(presenter, field) %></h2>
    <% if field.to_sym == :relationships %>
      <%# Entry point to the interactive relationship map, rendered only when the map
          has something to draw (issue #161). From a Portfolio it opens the
          whole-project diagram (?portfolio=); from a single work it opens that work's
          focused view (?focus=). Opens in an iframe modal so the user stays in the
          repository experience (client request), with the href as a non-JS fallback
          to the standalone map page. %>
      <%= enact_relationship_map_trigger presenter %>
    <% end %>
  </div>
  <div class="card-body">
    <% case field.to_sym %>
    <% when :relationships %>
      <%# OVERRIDE: Enact patch-cables view (outbound + reverse-lookup inbound). %>
      <%= render 'hyrax/compounds/related_within_project', presenter: presenter %>
    <% when :contributors %>
      <%# OVERRIDE: Enact contributors grouped by contributor (one row per person/org). %>
      <%= render 'hyrax/compounds/work_contributors', presenter: presenter %>
    <% else %>
      <%# upstream behavior: render the compound entries via CompoundAttributeRenderer %>
      <%= presenter.attribute_to_html(field.to_sym, render_as: :compound, value_only: true) %>
    <% end %>
  </div>
</div>
