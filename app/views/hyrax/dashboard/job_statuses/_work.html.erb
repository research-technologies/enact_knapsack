<details class="job-work"
         data-work="<%= work[:work_id] %>"
         data-state="<%= work[:state] %>"
         data-has-error="<%= work[:has_error] %>"
         <%= 'open' if work[:open] %>>

  <summary class="job-work-header">
    <span class="job-caret" aria-hidden="true">&rsaquo;</span>
    <span class="job-dot" aria-hidden="true"></span>
    <span class="job-work-title"><%= link_to work[:title], job_status_work_path(work) %></span>
    <span class="job-count"><%= work[:completed] %> of <%= work[:total] %> file sets</span>

    <div class="job-bar" aria-hidden="true">
      <div class="job-bar-fill" style="width: <%= work[:pct] %>%;"></div>
    </div>
  </summary>

  <div class="job-work-body">
    <%= render partial: 'file_set', collection: work[:file_sets], as: :file_set %>
  </div>
</details>
