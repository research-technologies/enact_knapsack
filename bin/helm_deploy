#!/bin/sh

# This script wraps up helm deployment. It is meant as a clear starting point for
# commandline deployment or CI based deployment. It requires the following ENV vars be set
#
# CHART_VERSION: this is the version of the hyrax chart you want to deploy. default - 0.22.0
# DEPLOY_IMAGE: this is the build image that runs the rails application. Typically this would run puma or passenger. eg: samvera/hyrax or ghcr.io/research-technologies/enact_knapsack. Defaults to gcrh.io/research-technologies/enact_knapsack/web
# WORKER_IMAGE: this is the worker target, usually built from the same Dockerfile as DEPLOY_IMAGE. eg: samvera/hyrax/worker or ghcr.io/research-technologies/enact_knapsack/worker. Defaults to gcrh.io/research-technologies/enact_knapsack/worker
# DEPLOY_TAG: name of of the tag you want to deploy for deploy image. eg: "latest" or "v3.0.1" or "f123asdf1". Defaults to latest
# WORKER_TAG: name of of the tag you want to deploy for deploy image. eg: "latest" or "v3.0.1" or "f123asdf1". Defaults to DEPLOY_TAG
# HELM_EXTRA_ARGS: any additional arguments you'd like passed to helm upgrade directly. can be blank.

if [ -z "$1" ] || [ -z "$2" ]
then
    echo './bin/helm_deploy RELEASE_NAME NAMESPACE'
    exit 1
fi
release_name="${1//_/-}"
namespace="${2//_/-}"

CHART_VERSION="${CHART_VERSION:-3.7.3}"

DEPLOY_IMAGE="${DEPLOY_IMAGE:-ghcr.io/research-technologies/enact_knapsack/web}"
WORKER_IMAGE="${WORKER_IMAGE:-ghcr.io/research-technologies/enact_knapsack/worker}"
DEPLOY_TAG="${DEPLOY_TAG:-latest}"
WORKER_TAG="${WORKER_TAG:-$DEPLOY_TAG}"
echo $DEPLOY_TAG

helm pull --untar oci://ghcr.io/samvera/charts/hyrax --version $CHART_VERSION
# Only update the helm repo locally - it breaks in CI containers and is not needed for OCI based charts
# helm repo update

# Snapshot each deployment's generation before helm touches anything. On an
# upgrade (not a first install) the deployments already exist and are
# already rolled out from the previous release, so `kubectl rollout status`
# called too early reports immediate success against the OLD rollout.
snapshot_file=$(mktemp)
for d in $(kubectl get deploy -n "$namespace" -l app.kubernetes.io/instance="$release_name" -o name 2>/dev/null); do
  echo "$d $(kubectl get "$d" -n "$namespace" -o jsonpath='{.metadata.generation}' 2>/dev/null)" >> "$snapshot_file"
done

# Stream rollout progress for visibility while helm waits (--atomic gives no
# output until it finishes). Informational only - it never decides
# success/failure, that's helm's own exit code below. Output is just
# replica/pod status, no secret values.
(
  for _ in $(seq 1 30); do
    deploys=$(kubectl get deploy -n "$namespace" -l app.kubernetes.io/instance="$release_name" -o name 2>/dev/null)
    [ -n "$deploys" ] && break
    sleep 2
  done
  for d in $deploys; do
    pre_gen=$(awk -v d="$d" '$1==d{print $2}' "$snapshot_file")
    if [ -n "$pre_gen" ]; then
      # Wait for helm to actually bump this deployment's generation before
      # trusting rollout status - otherwise it's just reporting the
      # previous release's already-steady state.
      for _ in $(seq 1 150); do
        cur_gen=$(kubectl get "$d" -n "$namespace" -o jsonpath='{.metadata.generation}' 2>/dev/null)
        [ "$cur_gen" != "$pre_gen" ] && break
        sleep 2
      done
    fi
    kubectl rollout status "$d" -n "$namespace" --timeout=15m
  done
) &
watch_pid=$!

helm upgrade \
    --install \
    --atomic \
    --timeout 15m0s \
    --set image.repository="$DEPLOY_IMAGE" \
    --set image.tag="$DEPLOY_TAG" \
    --set worker.image.repository="$WORKER_IMAGE" \
    --set worker.image.tag="$DEPLOY_TAG" \
    $HELM_EXTRA_ARGS \
    --namespace="$namespace" \
    --create-namespace \
    "$release_name" \
    hyrax
helm_status=$?

kill "$watch_pid" 2>/dev/null
wait "$watch_pid" 2>/dev/null
rm -f "$snapshot_file"

exit "$helm_status"
